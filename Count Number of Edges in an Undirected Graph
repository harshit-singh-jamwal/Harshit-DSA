#include<stdio.h>
#include<stdlib.h>
int main(){
    int num;
    scanf("%d",&num);
    int arr[num][num];
    int count=0;
    for(int i=0;i<num;i++){
        for(int j=0;j<num;j++){
            scanf("%d",&arr[i][j]);
            if(arr[i][j]==1){
                count++;
            }
        }
    }
    printf("%d",count/2);
    return 0;
}
