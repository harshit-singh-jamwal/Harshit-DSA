#include<stdio.h>
#include<stdlib.h>
#include<string.h>
int main(){
    char s[1000];
    printf("Enter a Expression: ");
    scanf("%[^\n]",s);
    int len=strlen(s),top=-1,flag=0;
    char stack[len];
    for(int i=0;i<len;i++){
        char ch=s[i];
        if(ch=='(' || ch=='[' || ch=='{'){
            stack[++top]=ch;
        }
        else if(ch==')' || ch==']' || ch=='}'){
            if(ch==')' && stack[top]=='('){
                top--;
            }
            else if(ch==']' && stack[top]=='['){
                top--;
            }
            else if(ch=='}' && stack[top]=='{'){
                top--;
            }
            else{
                flag=1;
                break;
            }
        }
    }
    if(flag==0 && top==-1){
        printf("%s is Valid",s);
    }
    else{
        printf("%s is Invalid",s);
    }
    return 0;
}
