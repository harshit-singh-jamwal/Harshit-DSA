#include <stdio.h>
#include <string.h>

#define MAX 1000
#define URL 101

char backStack[MAX][URL];
char forwardStack[MAX][URL];
int backTop = -1, forwardTop = -1;

int main() {
    int Q;
    scanf("%d", &Q);
    getchar();

    char current[URL] = "home.com";
    char command[120];

    while (Q--) {
        fgets(command, sizeof(command), stdin);
        command[strcspn(command, "\n")] = '\0';

        if (strncmp(command, "VISIT ", 6) == 0) {
            backTop++;
            strcpy(backStack[backTop], current);

            strcpy(current, command + 6);

            forwardTop = -1;
        }
        else if (strcmp(command, "BACK") == 0) {
            if (backTop != -1) {
                forwardTop++;
                strcpy(forwardStack[forwardTop], current);

                strcpy(current, backStack[backTop]);
                backTop--;
            }
            printf("%s\n", current);
        }
        else if (strcmp(command, "FORWARD") == 0) {
            if (forwardTop != -1) {
                backTop++;
                strcpy(backStack[backTop], current);

                strcpy(current, forwardStack[forwardTop]);
                forwardTop--;
            }
            printf("%s\n", current);
        }
        else if (strcmp(command, "CURRENT") == 0) {
            printf("%s\n", current);
        }
    }

    return 0;
}
