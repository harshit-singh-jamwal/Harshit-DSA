#include<stdio.h>
#include<stdlib.h>
int main(){
    int num;
    scanf("%d",&num);
    int tree[num];
    for(int i=0;i<num;i++){
        scanf("%d",&tree[i]);
    }
    int min=tree[0];
    for(int i=1;i<num;i++){
        if(tree[i]!=-1 && tree[i]<min){
            min=tree[i];
        }
    }
    printf("%d",min);
    return 0;
}
