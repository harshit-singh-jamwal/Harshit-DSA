#include<stdio.h>
#include<stdlib.h>
#include<string.h>
int main(){
    char s[1000];
    printf("Enter String: ");
    scanf("%[^\n]",s);
    int len=strlen(s);
    if(len==0)
        return 0;
    printf("%c",s[0]);
    for(int i=1;i<len;i++){
        if(s[i]!=s[i-1]){
            printf("%c",s[i]);
        }
    }
    return 0;
}
