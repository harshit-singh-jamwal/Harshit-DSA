#include<stdio.h>
#include<ctype.h>
#include<math.h>
#include<string.h>
int operand[100];
int top1 = -1;
void doProcessPrefix(){
    int x = operand[top1--];
    int y = operand[top1--];
    char op = operand[top1--];
    int z;
    switch(op){
        case '+': z = x + y; break;
        case '-': z = x - y; break;
        case '*': z = x * y; break;
        case '/': z = x / y; break;
        case '^': z = pow(x,y); break;
        default: z = 0;
    }
    operand[++top1] = z;
}
int evaluatePrefix(char *exp){
    int len = strlen(exp);
    for(int i=len-1;i>=0;i--){
        if(exp[i]==' ')
            continue;        
        if(isdigit(exp[i])){
            int num = 0;
            int base = 1;
            while(i>=0 && isdigit(exp[i])){
                num += (exp[i]-'0') * base;
                base *= 10;
                i--;
            }
            i++;
            operand[++top1] = num;
        }       
        else if(exp[i]=='+' || exp[i]=='-' || exp[i]=='*' ||
                exp[i]=='/' || exp[i]=='^'){
            int x = operand[top1--];
            int y = operand[top1--];
            int z=0;
            switch(exp[i]){
                case '+': z = x + y; break;
                case '-': z = x - y; break;
                case '*': z = x * y; break;
                case '/': z = x / y; break;
                case '^': z = pow(x,y); break;
            }
            operand[++top1] = z;
        }
    }
   return operand[top1];
}
int main(){
    char exp[100];
    printf("Enter Prefix Expression: ");
    scanf("%[^\n]",exp);
    printf("Answer is:%d",evaluatePrefix(exp));
    return 0;
}
