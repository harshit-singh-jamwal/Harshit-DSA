#include<stdio.h>
#include<stdlib.h>
#include<string.h>
int main(){
    char s[1000];
    printf("Enter Expression: ");
    scanf("%[^\n]",s);
    int len=strlen(s),top=-1;
    char stack[len];
    for(int i=0;i<len;i++){
        if(s[i]!='*'){
            stack[++top]=s[i];
        }
        else{
            top--;
        }
    }
    stack[++top]='\0';
    printf("Final Expression is: %s ",stack);
    return 0;
}
