#include<stdio.h>
#include<stdlib.h>
int main(){
    int num;
    scanf("%d",&num);
    int arr[num];
    for(int i=0;i<num;i++){
        scanf("%d",&arr[i]);
    }
    int y,count=0;
    scanf("%d",&y);
    for(int i=0;i<num;i++){
        if(arr[i]==y){
            printf("%d found in array",arr[i]);
            count++;
        }
    }
    if(count==0){
        printf("%d not found in array",y);
    }
    return 0;
}
