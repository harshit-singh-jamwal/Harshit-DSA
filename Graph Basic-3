#include<stdio.h>
#include<stdlib.h>
int main(){
    int n,e;
    scanf("%d %d",&n,&e);
    int arr[10][10]={0};
    for(int i=0;i<e;i++){
        int u,v;
        scanf("%d %d",&u,&v);
        arr[u][v]=1;
        arr[v][u]=1;
    }
    int s;
    scanf("%d",&s);
    int visited[10]={0};
    int stack[10],top=-1;
    stack[++top]=s;
    visited[s]=1;
    while(top!=-1){
        int curr=stack[top--];
        printf("%d ",curr);
        for(int i=n;i>=0;i--){
            if(arr[curr][i]==1 && visited[i]==0){
                stack[++top]=i;
                visited[i]=1;
            }
        }
    }
    return 0;
}
