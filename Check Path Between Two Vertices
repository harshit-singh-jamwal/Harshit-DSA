#include<stdio.h>
#include<stdlib.h>
int main(){
    int n,e;
    scanf("%d %d",&n,&e);
    int arr[10][10]={0};
    for(int i=0;i<e;i++){
        int u,v;
        scanf("%d %d",&u,&v);
        arr[u][v]=1;
        arr[v][u]=1;
    }
    int s,d;
    scanf("%d %d",&s,&d);
    int visited[10]={0};
    int stack[10],top=-1;
    stack[++top]=s;
    visited[s]=1;
    while(top!=-1){
        int curr=stack[top--];
        if(curr==d){
            printf("Path Exists");
            return 0;
        }
        for(int i=0;i<n;i++){
            if(arr[curr][i]==1 && visited[i]==0){
                stack[++top]=i;
                visited[i]=1;
            }
        }
    }
    printf("No Path");
    return 0;
}
