#include<stdio.h>
#include<stdlib.h>
int main(){
    int n,e;
    int arr[10][10]={0};
    scanf("%d %d",&n,&e);
    for(int i=0;i<e;i++){
        int u,v;
        scanf("%d %d",&u,&v);
        arr[u][v]=1;
        arr[v][u]=1;
    }
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            printf("%d ",arr[i][j]);
        }
        printf("\n");
    }
    return 0;
}
